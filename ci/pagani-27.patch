+        new_info = self.layout.roots['__PRELINK_INFO']
+        self.data[new_info['fileoff']:new_info['fileoff'] + new_info['filesize']] = \
+            self.cache.data[old_info['fileoff']:old_info['fileoff'] + old_info['filesize']]
