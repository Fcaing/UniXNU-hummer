+    def pair_metaclass_getters(self, known):
+        """Identify getMetaClass by its sole known metaobject and exact code shape."""
+        getters = defaultdict(set)
+        for n,fn in self.native.functions.items():
+            if fn['calls'] or len(fn['refs']) != 1:
+                continue
