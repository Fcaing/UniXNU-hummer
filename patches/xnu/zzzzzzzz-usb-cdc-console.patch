diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 715c545..840a9d6 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -47,6 +47,9 @@
 #include <kern/cpu_data.h>
 #include <kern/sched_prim.h>
 #include <libkern/section_keywords.h>
+#if XNU_QCOM_USB_DEBUG
+#include <QcomXnuUsbDebug.h>
+#endif
 
 #if __arm64__
 #include <machine/machine_routines.h>
@@ -531,6 +534,19 @@ console_write(char *str, int size)
 
 	assert(str != NULL);
 
+#if XNU_QCOM_USB_DEBUG
+	/* Capture raw formatted bytes before the original ring can reject them.
+	 * The native API accepts at most 16 KiB per call; submit every chunk so
+	 * a long console write does not lose its suffix to that call budget.
+	 */
+	for (int offset = 0; offset < size;) {
+		int bytes = size - offset;
+		if (bytes > 16384) bytes = 16384;
+		(void)qcom_usb_debug_write(str + offset, (size_t)bytes);
+		offset += bytes;
+	}
+#endif
+
 	char *write_ptr = NULL;
 	int chunk_size = CPU_CONS_BUF_SIZE;
 	int i = 0;
@@ -614,6 +630,10 @@ console_write_unbuffered(char c)
 		return;
 	}
 
+#if XNU_QCOM_USB_DEBUG
+	/* Tee raw bytes once, before the selected console's CRLF expansion. */
+	qcom_usb_debug_putc(c);
+#endif
 	_cnputc(c, true);
 }
 
